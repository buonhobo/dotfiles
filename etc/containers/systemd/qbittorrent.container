[Unit]
Description=qbittorrent podman container from linuxserver
RequiresMountsFor=/home/shared
After=protonvpn.service
Requires=protonvpn.service
PartOf=gluetun.service

[Container]
Image=lscr.io/linuxserver/qbittorrent
ContainerName=qbittorrent
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Europe/Rome
Environment=WEBUI_PORT=8080
Volume=/home/shared/.config/qbittorrent-nox:/config:Z
Volume=/home/shared/Media:/data:z
AutoUpdate=registry

#PublishPort=8080:8080
#PublishPort=6881:6881/tcp
#PublishPort=6881:6881/udp
#Network=servarr.network

Network=container:protonvpn

[Service]
Restart=always

[Install]
WantedBy=default.target
