[Unit]
Description=prowlarr podman container from linuxserver
RequiresMountsFor=/home/shared
After=protonvpn.service
Requires=protonvpn.service
PartOf=protonvpn.service

[Container]
Image=lscr.io/linuxserver/prowlarr
ContainerName=prowlarr
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Europe/Rome
Volume=/home/shared/.config/prowlarr:/config:Z
AutoUpdate=registry

#Network=servarr.network
#PublishPort=9696:9696

Network=container:protonvpn

[Service]
Restart=always

[Install]
WantedBy=default.target
