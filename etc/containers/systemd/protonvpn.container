[Unit]
Description=gluetun container for protonvpn
RequiresMountsFor=/home/shared

[Container]
Image=docker.io/qmcgaw/gluetun
ContainerName=protonvpn
AddCapability=NET_ADMIN
AddCapability=NET_RAW
AddDevice=/dev/net/tun:/dev/net/tun
Environment=VPN_SERVICE_PROVIDER=protonvpn
Environment=VPN_TYPE=wireguard
Environment=WIREGUARD_PRIVATE_KEY=REDACTED
Environment=SERVER_COUNTRIES=Italy
Environment=VPN_PORT_FORWARDING=on
Environment=PORT_FORWARD_ONLY=on
Environment=GLUETUN_HTTP_CONTROL_SERVER_ENABLE=on
AutoUpdate=registry

Volume=/home/shared/.config/protonvpn/config.toml:/gluetun/auth/config.toml:z

#Qbittorrent
PublishPort=8080:8080

#Prowlarr
PublishPort=9696:9696

#Radarr
PublishPort=7878:7878

#Sonarr
PublishPort=8989:8989

Network=servarr.network

[Service]
Restart=always

[Install]
WantedBy=default.target
