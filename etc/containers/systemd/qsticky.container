[Unit]
Description=qsticky podman container for port forwarding sync
RequiresMountsFor=/home/shared
After=protonvpn.service
Requires=protonvpn.service
PartOf=gluetun.service

[Container]
Image=ghcr.io/monstermuffin/qsticky
ContainerName=qsticky
Environment=QBITTORRENT_HOST=protonvpn
Environment=QBITTORRENT_PORT=8080
Environment=QBITTORRENT_HTTPS=false
Environment=QBITTORRENT_API_KEY=REDACTED

Environment=GLUETUN_HOST=protonvpn
Environment=GLUETUN_AUTH_TYPE=apikey
Environment=GLUETUN_APIKEY=your_api_key_here
Environment=LOG_LEVEL=INFO

AutoUpdate=registry

Network=servarr.network

[Service]
Restart=always

[Install]
WantedBy=default.target
